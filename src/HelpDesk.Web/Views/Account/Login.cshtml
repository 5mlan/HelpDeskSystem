@model LoginViewModel
@{
    ViewData["Title"] = "تسجيل الدخول";
}
<div class="auth-layout">
    <section class="auth-visual">
        <div class="auth-brand"><span class="brand-mark">HD</span><strong>HelpDesk</strong></div>
        <div>
            <span class="eyebrow">دعم أسرع • متابعة أوضح</span>
            <h1>كل طلبات الدعم التقني<br />في مكان واحد.</h1>
            <p>أنشئ تذكرتك، تابع حالتها، وتواصل مع فريق الدعم بسهولة.</p>
        </div>
        <div class="auth-stats">
            <div><strong>24/7</strong><span>متابعة التذاكر</span></div>
            <div><strong>3</strong><span>مستويات صلاحية</span></div>
            <div><strong>100%</strong><span>سجل واضح</span></div>
        </div>
    </section>
    <section class="auth-form-wrap">
        <form asp-action="Login" method="post" class="auth-card">
            <input asp-for="ReturnUrl" type="hidden" />
            <span class="auth-mobile-logo">HD</span>
            <h2>مرحبًا بعودتك</h2>
            <p>أدخل بياناتك للوصول إلى مركز الدعم.</p>
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" placeholder="name@company.com" autocomplete="email" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>
            <label class="checkbox-row"><input asp-for="RememberMe" /> <span>تذكرني على هذا الجهاز</span></label>
            <button type="submit" class="btn btn-primary btn-block">تسجيل الدخول</button>
            <div class="auth-switch">ليس لديك حساب؟ <a asp-action="Register">إنشاء حساب جديد</a></div>
            <details class="demo-accounts">
                <summary>حسابات التجربة</summary>
                <code>admin@helpdesk.local / Admin123!</code>
                <code>tech@helpdesk.local / Tech123!</code>
                <code>user@helpdesk.local / User123!</code>
            </details>
        </form>
    </section>
</div>
