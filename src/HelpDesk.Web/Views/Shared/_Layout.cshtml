<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="نظام إدارة تذاكر الدعم الفني" />
    <title>@ViewData["Title"] - HelpDesk</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <aside class="sidebar" id="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">HD</span>
                <span><strong>HelpDesk</strong><small>مركز الدعم التقني</small></span>
            </a>

            <nav class="side-nav">
                <span class="nav-label">القائمة الرئيسية</span>
                <a asp-controller="Home" asp-action="Index"><span class="nav-icon">⌂</span> لوحة المعلومات</a>
                <a asp-controller="Tickets" asp-action="Index"><span class="nav-icon">▤</span> التذاكر</a>
                <a asp-controller="Tickets" asp-action="Create"><span class="nav-icon">＋</span> تذكرة جديدة</a>
                @if (User.IsInRole("Admin"))
                {
                    <span class="nav-label">الإدارة</span>
                    <a asp-controller="Admin" asp-action="Users"><span class="nav-icon">♙</span> المستخدمون والصلاحيات</a>
                }
            </nav>

            <div class="sidebar-user">
                <div class="avatar">@(User.Identity.Name?.Substring(0, 1).ToUpper())</div>
                <div><strong>@User.Identity.Name</strong><small>@(User.IsInRole("Admin") ? "مدير النظام" : User.IsInRole("Technician") ? "فني دعم" : "مستخدم")</small></div>
            </div>
        </aside>

        <div class="app-shell">
            <header class="topbar">
                <button class="menu-button" id="menuButton" type="button" aria-label="فتح القائمة">☰</button>
                <div class="topbar-title">
                    <span class="status-dot"></span>
                    النظام يعمل بشكل طبيعي
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button class="logout-button" type="submit">تسجيل الخروج</button>
                </form>
            </header>
            <main class="main-content">
                @if (TempData["Success"] is string success)
                {
                    <div class="alert alert-success">✓ @success</div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-error">! @error</div>
                }
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <main class="auth-page">@RenderBody()</main>
    }

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
