<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HelpDesk.Web</RootNamespace>
    <Version>1.1.0</Version>
    <Authors>Salem Al-Mokhles</Authors>
    <Description>Role-based IT support ticket system with an Arabic responsive interface.</Description>
    <RepositoryUrl>https://github.com/5mlan/it-help-desk-system</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.30" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.30" />
  </ItemGroup>
</Project>
